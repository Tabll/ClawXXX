+  clawxNamespaceBytes += bytes;
+  while (clawxNamespaceCache.size > 1024 || clawxNamespaceBytes > 32 * 1024 * 1024) {
+    const oldest = clawxNamespaceCache.keys().next().value!;
+    clawxNamespaceBytes -= Buffer.byteLength(clawxNamespaceCache.get(oldest)!);
