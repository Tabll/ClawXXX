+const clawxNamespaceCache = new Map<string, string>();
+let clawxNamespaceBytes = 0;
+function cacheManagedNamespace(key: string, data: unknown): void {
+  const serialized = JSON.stringify(data);
+  const previous = clawxNamespaceCache.get(key);
+  if (previous) clawxNamespaceBytes -= Buffer.byteLength(previous);
+  clawxNamespaceCache.delete(key);
+  const bytes = Buffer.byteLength(serialized);
+  if (bytes > 32 * 1024 * 1024) return;
