diff --git a/dist/clawx-managed-storage.js b/dist/clawx-managed-storage.js
new file mode 100644
index 0000000..689ca17
--- /dev/null
+++ b/dist/clawx-managed-storage.js
@@ -0,0 +1,35 @@
+// ClawX business history is owned by DataService. These connection-local
+// fences preserve configuration, credentials and rebuildable memory indexes.
+// TEMP triggers never alter another process/kernel's schema or old records.
+export function isClawXHistoryTable(name, kind) {
+  if (kind === "agent") return /^(?:sessions$|session_(?!key_contract$)|conversations$|conversation_deliveries$|transcript_|trajectory_runtime_events$|acp_parent_stream_events$|context_engine_turn_outbox$|heartbeat_outcomes$|message_tool_run_outcomes$)/.test(name);
+  return /^(?:acp_(?:replay_|sessions$)|cron_|session_(?:state_|upstream_links$|watch_cursors$)|task_runs$|subagent_runs$|flow_runs$|meeting_transcript_|worker_transcript_|worker_inference_turns$)/.test(name) || CLAWX_TRANSIENT_TRANSPORT_TABLES.has(name);
+}
+
+// Transport receipts, approvals and component handles may be needed during a
+// live delivery, but cannot become another persisted message/run authority.
+const CLAWX_TRANSIENT_TRANSPORT_TABLES = new Set([
+  "channel_ingress_events", "plugin_state_entries", "delivery_queue_entries",
+  "outbound_message_execution_bindings", "outbound_message_progress",
+  "operator_approvals", "operator_approval_execution_identities",
+  "execution_identity_contexts", "execution_decision_facts", "execution_owner_lifecycle_bindings",
+  "plugin_binding_approvals", "task_delivery_state"
+]);
+
+export function installClawXStorageFence(db, kind, env = process.env) {
+  if (env.CLAWX_MANAGED_RUNTIME !== "1") return;
+  const primary = db.prepare("PRAGMA database_list").all().find(row => row.name === "main");
+  if (!primary?.file) return; // Native incognito execution is intentionally in memory.
+  db.exec("PRAGMA temp_store=MEMORY");
+  for (const { name, sql } of db.prepare("SELECT name, sql FROM sqlite_master WHERE type = 'table'").all()) {
+    if (!isClawXHistoryTable(name, kind) || /\bVIRTUAL\s+TABLE\b/i.test(sql ?? "") || /_fts(?:_|$)/.test(name)) continue;
+    if (!/^[a-z0-9_]+$/.test(name)) throw new Error("Unexpected managed storage table identity");
+    if (kind === "state" && CLAWX_TRANSIENT_TRANSPORT_TABLES.has(name)) {
+      if (!/^CREATE TABLE\s/i.test(sql ?? "")) throw new Error("Unexpected transient transport schema");
+      // Preserve PKs/CHECKs and the upstream queue state machine. Start empty;
+      // no SELECT/copy from native records, including a previous installation.
+      db.exec(sql.replace(/^CREATE TABLE\s+(?:IF NOT EXISTS\s+)?/i, "CREATE TEMP TABLE IF NOT EXISTS "));
+    }
+    for (const operation of ["INSERT", "UPDATE", "DELETE"]) db.exec(`CREATE TEMP TRIGGER IF NOT EXISTS clawx_no_${operation.toLowerCase()}_${name} BEFORE ${operation} ON main."${name}" BEGIN SELECT RAISE(ABORT, 'ClawX canonical history cannot persist in native OpenClaw storage'); END`);
+  }
+}
