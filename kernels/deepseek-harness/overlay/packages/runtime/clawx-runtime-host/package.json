{
  "name": "@clawx/dsh-runtime-host",
  "description": "Single-process ClawX runtime host for DeepSeek Harness",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "clawx-dsh-runtime": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./home-lock": {
      "types": "./lib/types/home-lock.d.ts",
      "default": "./lib/home-lock.js"
    },
    "./host-bridge": {
      "types": "./lib/types/host-bridge.d.ts",
      "default": "./lib/host-bridge.js"
    },
    "./bin": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/bin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/home-lock.js",
    "lib/host-bridge.js",
    "lib/bin.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
