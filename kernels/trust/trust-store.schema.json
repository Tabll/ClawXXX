{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claw-x.com/schemas/kernel-trust-store-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "keys": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "purposes", "publicKeyPem", "notBefore", "notAfter"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "algorithm": { "const": "Ed25519" },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["artifact", "catalog", "rollback"] }
          },
          "publicKeyPem": { "type": "string", "minLength": 80, "maxLength": 1024 },
          "notBefore": { "type": "string", "format": "date-time" },
          "notAfter": { "type": "string", "format": "date-time" },
          "revokedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
