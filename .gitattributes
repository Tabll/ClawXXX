# Unified diff payloads are checked after application by the strict runtime pipeline.
# Treating their literal `+ <tab>` lines as repository indentation creates false positives.
patches/*.patch -whitespace
kernels/*/patches/*.patch -whitespace

# Frozen supply-chain inputs are hashed byte-for-byte on every CI target.
kernels/** text eol=lf
patches/** text eol=lf
pnpm-lock.yaml text eol=lf
scripts/** text eol=lf
